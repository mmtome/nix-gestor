// NIX Gestor — schema de dados (PostgreSQL)
// Espelha a seção 4 da especificação: enums e Json nativos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon entrega a URL agrupada (pooled). Migrations precisam de conexão direta.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum ProjectStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_ADDED
  DUE_DATE_CHANGED
  TASK_COMPLETED
  MENTIONED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarColor  String   @default("#8013A8")
  avatarUrl    String?
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  memberships    ProjectMember[]
  assignedTasks  Task[]             @relation("TaskAssignee")
  createdTasks   Task[]             @relation("TaskCreator")
  comments       Comment[]
  activities     ActivityLog[]
  notifications  Notification[]
  viewPrefs      ViewPreference[]
  collaborations TaskCollaborator[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  icon        String        @default("layout-list")
  color       String        @default("#8013A8")
  status      ProjectStatus @default(ON_TRACK)
  startDate   DateTime?
  endDate     DateTime?
  archived    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members    ProjectMember[]
  sections   Section[]
  tasks      TaskProject[]
  tags       Tag[]
  viewPrefs  ViewPreference[]
  templates  SubtaskTemplate[]
  instagram  InstagramAccount?
  relatorios RelatorioMensal[]
  stories    StoryColetado[]
  direct     MensagemDirect[]
  exportados DadosExportados[]
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(EDITOR)
  favorite  Boolean     @default(false)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Section {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     String
  createdAt DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskProject[]

  @@index([projectId])
}

model Task {
  id               String    @id @default(cuid())
  title            String
  description      String?
  completed        Boolean   @default(false)
  completedAt      DateTime?
  dueAt            DateTime?
  dueHasTime       Boolean   @default(false)
  startAt          DateTime?
  estimatedMinutes Int?
  parentTaskId     String?
  subtaskOrder     String?
  assigneeId       String?
  creatorId        String
  likes            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /**
   * --- publicação automática no Instagram -------------------------------
   */
  /**
   * /**
   * /**
   * /* O check de aprovação é a única ação manual: a partir dele, o post sobe
   * sozinho quando `dueAt` chegar. Ver src/lib/publicador.ts.
   */
  aprovadoParaPublicar Boolean   @default(false)
  aprovadoEm           DateTime?
  aprovadoPorId        String?
  legenda              String?
  publicacaoStatus     String?
  publicadoEm          DateTime?
  publicacaoErro       String?
  instagramMediaId     String?
  instagramPermalink   String?

  parent        Task?              @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks      Task[]             @relation("Subtasks")
  assignee      User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator       User               @relation("TaskCreator", fields: [creatorId], references: [id])
  projects      TaskProject[]
  tags          TaskTag[]
  comments      Comment[]
  attachments   Attachment[]
  activities    ActivityLog[]
  collaborators TaskCollaborator[]
  blockedBy     TaskDependency[]   @relation("Blocked")
  blocking      TaskDependency[]   @relation("Blocking")

  @@index([assigneeId, completed, dueAt])
  @@index([parentTaskId])
  /**
   * O cron varre exatamente por isto: aprovado, ainda não publicado, vencido.
   */
  @@index([aprovadoParaPublicar, publicadoEm, dueAt])
}

model TaskProject {
  taskId    String
  projectId String
  sectionId String?
  order     String

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@id([taskId, projectId])
  @@index([projectId, sectionId])
}

model TaskDependency {
  blockedId  String
  blockingId String

  blocked  Task @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocking Task @relation("Blocking", fields: [blockingId], references: [id], onDelete: Cascade)

  @@id([blockedId, blockingId])
}

model TaskCollaborator {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Tag {
  id        String  @id @default(cuid())
  name      String
  color     String
  projectId String?

  project Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskTag[]

  @@unique([name, projectId])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Comment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  taskId     String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  isImage    Boolean  @default(false)
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  type      String
  meta      Json?
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  taskId    String?
  actorId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model ViewPreference {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  viewType  String
  filters   Json
  sortBy    String?
  groupBy   String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, viewType])
}

model SubtaskTemplate {
  id        String  @id @default(cuid())
  projectId String?
  name      String
  items     Json

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/**
 * ============================================================================
 * Relatório de resultados — uma apresentação mensal por conta de Instagram.
 * Fonte híbrida: quando a conta está conectada à API da Meta, os números vêm
 * de lá; qualquer campo continua editável à mão. O campo `fonte` registra o
 * que aconteceu em cada relatório.
 * Os blocos que variam de tamanho (faixas etárias, cidades, gêneros, curva de
 * horários e os destaques de post) ficam em Json: a forma deles muda conforme
 * a conta e criar cinco tabelas para isso só tornaria a edição mais difícil.
 * ==========================================================================
 */

model InstagramAccount {
  id          String    @id @default(cuid())
  projectId   String    @unique
  username    String
  igUserId    String?
  accessToken String?
  conectadoEm DateTime?
  criadoEm    DateTime  @default(now())

  /// Coleta do Direct: desde quando passa de hora em hora (dali em diante o
  /// mês é completo), a conversa mais recente já lida e onde parou a leitura
  /// do histórico ("fim" quando terminou).
  directDesde  DateTime?
  directAte    DateTime?
  directCursor String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RelatorioMensal {
  id        String @id @default(cuid())
  projectId String
  ano       Int
  mes       Int

  cliente String?

  // Visão geral
  posts            Int     @default(0)
  feeds            Int     @default(0)
  reels            Int     @default(0)
  stories          Int     @default(0)
  visualizacoes    Int     @default(0)
  alcance          Int     @default(0)
  mediaViewReels   Int     @default(0)
  mediaViewStories Int     @default(0)
  freqExibicao     Float   @default(0)
  taxaEngajamento  Float   @default(0)
  taxaCrescimento  Float   @default(0)
  formatoTop       String?

  // Audiência
  seguidores      Int     @default(0)
  seguidoresDelta Int     @default(0)
  idades          Json    @default("[]")
  localizacoes    Json    @default("[]")
  generos         Json    @default("[]")
  horarios        Json    @default("[]")
  notaAudiencia   String?

  // Destaques de desempenho
  topVisualizacoes  Json @default("[]")
  piorVisualizacoes Json @default("[]")
  topInteracoes     Json @default("[]")
  piorInteracoes    Json @default("[]")

  // Totais do mês — alimentam os gráficos comparativos do ano
  interacoes        Int @default(0)
  curtidas          Int @default(0)
  comentarios       Int @default(0)
  compartilhamentos Int @default(0)
  salvos            Int @default(0)
  cliquesLink       Int @default(0)

  conclusao String?

  // O que vem a mais da API e não tem coluna própria: comunidade (comentários),
  // desempenho por formato, melhores dias e horários, visualizações por tipo.
  extras Json @default("{}")

  fonte        String   @default("manual")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ano, mes])
  @@index([projectId, ano])
}

/// Story de uma conta conectada, guardado enquanto está no ar. A Meta apaga os
/// números do story em 24 h; a coleta de hora em hora (/api/cron/stories) é o
/// que deixa o relatório do mês contar stories.
model StoryColetado {
  id                String   @id @default(cuid())
  projectId         String
  mediaId           String   @unique
  publicadoEm       DateTime
  tipo              String?
  views             Int      @default(0)
  reach             Int      @default(0)
  respostas         Int      @default(0)
  compartilhamentos Int      @default(0)
  interacoes        Int      @default(0)
  coletadoEm        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, publicadoEm])
}

/// Uma mensagem do Direct lida pela API. Sem o texto: só o horário, quem
/// mandou (id com hash), o tipo e o que foi extraído dele na leitura (assunto,
/// pergunta, emojis). O resumo do mês sai daqui para DadosExportados.
model MensagemDirect {
  id         String   @id
  projectId  String
  conversaId String
  em         DateTime
  daConta    Boolean
  autor      String
  tipo       String
  dados      Json
  coletadaEm DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, em])
  @@index([projectId, conversaId])
}

/// Resumo por mês do arquivo de "Exportar suas informações" do Instagram.
/// O arquivo é lido no navegador; aqui chegam só os números agregados
/// (`tipo`: "direct", "seguidores", "conteudo") — nunca as conversas.
model DadosExportados {
  id           String   @id @default(cuid())
  projectId    String
  ano          Int
  mes          Int
  tipo         String
  dados        Json
  atualizadoEm DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ano, mes, tipo])
}

// ============================================================================
// SAC: prints de dúvidas de clientes mandados num grupo de WhatsApp (docs/sac).
// A Evolution API manda cada mensagem do grupo para /api/sac/webhook; o print
// vira card e a reação ou a resposta no grupo muda o status. Não pertence a
// projeto: é uma aba própria do gestor.
// ============================================================================

/// Configuração única (id "sac"), editada na tela de configurações do SAC.
/// A chave da Evolution fica cifrada (lib/meta.ts → cifrar).
model SacConfig {
  id                 String   @id @default("sac")
  evolutionUrl       String?
  evolutionKey       String?
  evolutionInstancia String   @default("sac")
  webhookToken       String
  groupJid           String?
  groupNome          String?
  /// fromMe | allowlist | any
  senderMode         String   @default("fromMe")
  allowedSenders     String[] @default([])
  albumWindowSeconds Int      @default(60)
  slaAmareloHoras    Int      @default(2)
  slaVermelhoHoras   Int      @default(6)
  emojisResolvido    String[] @default(["✅", "✔️", "☑️"])
  emojisArquivado    String[] @default(["❌"])
  /// Ao resolver pelo gestor, reage ✅ no print do grupo.
  reagirAoResolver   Boolean  @default(true)
  logPayloads        Boolean  @default(true)
  atualizadoEm       DateTime @updatedAt
}

/// Dicionário da legenda: #ig, #ingresso, #lapa… (type: canal | categoria | evento | prioridade).
model SacTag {
  slug    String   @id
  type    String
  label   String
  aliases String[] @default([])
  color   String?
  active  Boolean  @default(true)
  sort    Int      @default(0)

  cardsCanal      SacCard[] @relation("SacCanal")
  cardsCategoria  SacCard[] @relation("SacCategoria")
  cardsEvento     SacCard[] @relation("SacEvento")
  cardsPrioridade SacCard[] @relation("SacPrioridade")
}

/// status: novo | respondido_grupo | resolvido | arquivado
model SacCard {
  id                String    @id @default(cuid())
  /// id do print principal no WhatsApp
  waMessageId       String    @unique
  groupJid          String
  status            String    @default("novo")
  canal             String?
  categoria         String?
  evento            String?
  prioridade        String?
  titulo            String    @default("")
  legendaOriginal   String    @default("")
  tagsDesconhecidas String[]  @default([])
  senderId          String?
  senderName        String?
  senderFromMe      Boolean   @default(false)
  /// rank fracionado dentro da coluna (lib/ordering.ts)
  ordem             String
  receivedAt        DateTime
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  resolvedBy        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  canalTag      SacTag? @relation("SacCanal", fields: [canal], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  categoriaTag  SacTag? @relation("SacCategoria", fields: [categoria], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  eventoTag     SacTag? @relation("SacEvento", fields: [evento], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  prioridadeTag SacTag? @relation("SacPrioridade", fields: [prioridade], references: [slug], onDelete: SetNull, onUpdate: Cascade)

  attachments SacAttachment[]
  comments    SacComment[]
  events      SacEvent[]

  @@index([status, receivedAt(sort: Desc)])
  @@index([senderId, receivedAt(sort: Desc)])
}

/// Imagens do card. O print principal também entra aqui, com o mesmo waMessageId do card.
model SacAttachment {
  id          String   @id @default(cuid())
  cardId      String
  waMessageId String   @unique
  storageKey  String
  mimetype    String
  createdAt   DateTime @default(now())

  card SacCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// source: whatsapp (resposta no grupo) | gestor (nota interna)
model SacComment {
  id          String   @id @default(cuid())
  cardId      String
  waMessageId String?  @unique
  authorId    String?
  authorName  String?
  text        String
  source      String
  createdAt   DateTime @default(now())

  card SacCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

/// Histórico do card. type: criado | status | comentario | anexo | anexo_removido | reclassificado
/// via: reacao | resposta | gestor | sistema
model SacEvent {
  id          Int      @id @default(autoincrement())
  cardId      String
  type        String
  fromStatus  String?
  toStatus    String?
  via         String?
  actorId     String?
  actorName   String?
  emoji       String?
  waMessageId String?
  createdAt   DateTime @default(now())

  card SacCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([waMessageId])
}

/// O que chegou no webhook, sem as imagens (base64 sai antes de gravar).
/// Só mensagens de grupo: conversa de cliente com o número nunca é gravada.
model SacWebhookLog {
  id         Int      @id @default(autoincrement())
  receivedAt DateTime @default(now())
  event      String?
  payload    Json
  result     String?

  @@index([receivedAt])
}

/// Grupos e remetentes vistos pelo webhook, para escolher na tela de configurações.
/// tipo: grupo | remetente (só do grupo monitorado)
model SacVisto {
  jid     String   @id
  tipo    String
  nome    String?
  vistoEm DateTime @default(now())
  total   Int      @default(1)
}
